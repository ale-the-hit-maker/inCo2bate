# ============================================================
# IncuSense — configurazione email (alert) per consegna REALE
# ============================================================
# 1) Copia questo file in ".env" nella stessa cartella:
#       copy .env.example .env        (Windows)
# 2) Compila i valori SMTP qui sotto.
# 3) Avvia/riavvia:  docker compose up -d backend
# Docker Compose legge automaticamente il file ".env".
#
# ---- ESEMPIO GMAIL (consegna reale alla tua casella) ----
# Richiede una "App Password" Google (NON la password normale):
#   - attiva la verifica in due passaggi sull'account Google
#   - https://myaccount.google.com/apppasswords  -> crea una password app "Mail"
#   - incolla quella password (16 caratteri) in SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=tuo.indirizzo@gmail.com
SMTP_PASSWORD=xxxxxxxxxxxxxxxx
ALERT_FROM=tuo.indirizzo@gmail.com

# Altri provider (in alternativa a Gmail):
#   Brevo (Sendinblue): SMTP_HOST=smtp-relay.brevo.com  SMTP_PORT=587
#   SendGrid:           SMTP_HOST=smtp.sendgrid.net      SMTP_PORT=587  SMTP_USERNAME=apikey
#   Mailgun:            SMTP_HOST=smtp.mailgun.org       SMTP_PORT=587
